# ==============================================================================
# CloudPass Environment Configuration Template
# Copy to .env for Docker Compose or configure via Azure App Service / Key Vault
# NEVER commit actual production secrets to Git.
# ==============================================================================

# Database Configuration ("SqlServer" for Azure SQL / Docker SQL, "Sqlite" for local quickstart)
Database__Provider=SqlServer
SQL_SA_PASSWORD=ChangeMe_StrongSqlPass!2026
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=CloudPassDb;User Id=sa;Password=ChangeMe_StrongSqlPass!2026;TrustServerCertificate=True;

# Cryptographic Ticket & Bus Pass Signing Secret (min 32 random chars in production)
CLOUDPASS_TICKET_SIGNING_SECRET=replace-with-64-char-cryptographically-random-secret

# Razorpay Sandbox / Test-Mode Payment Gateway Secrets
RAZORPAY_TEST_KEY_ID=rzp_test_replace_with_your_test_key
CLOUDPASS_PAYMENT_KEY_SECRET=replace-with-razorpay-test-key-secret
CLOUDPASS_PAYMENT_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# Azure Cloud Storage & Telemetry (Production)
Storage__Provider=AzureBlob
CLOUDPASS_AZURE_BLOB_CONNECTION=
Storage__ContainerName=cloudpass-tickets
APPLICATIONINSIGHTS_CONNECTION_STRING=
