{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/cloudpass.db"
  },
  "Security": {
    "TicketSigningSecret": "",
    "EnforceSingleUseTicketValidation": true
  },
  "PaymentGateway": {
    "Provider": "Razorpay-TestMode",
    "KeyId": "rzp_test_cloudpass_demo",
    "KeySecret": "",
    "WebhookSecret": "",
    "TestMode": true
  },
  "Storage": {
    "Provider": "Local",
    "AzureBlobConnectionString": "",
    "ContainerName": "cloudpass-tickets",
    "LocalRootPath": "App_Data/CloudStorage"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}
