@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CloudPass Admin Console</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/cloudpass.css" asp-append-version="true" />
</head>
<body>
    <div class="cp-admin-shell">
        <aside class="cp-admin-sidebar">
            <a class="cp-brand mb-4 px-2" asp-controller="Home" asp-action="Index">
                <i class="bi bi-cloud-check-fill text-info fs-3"></i>
                <div>
                    <div>CLOUD<span class="cp-brand-accent">PASS</span></div>
                    <div style="font-size:0.68rem;letter-spacing:0.12em;color:#67E8F9;font-weight:700;">ADMIN CONSOLE</div>
                </div>
            </a>

            <nav class="nav flex-column flex-grow-1">
                <a class="nav-link @(currentAction == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>Dashboard Overview
                </a>
                <a class="nav-link @(currentAction == "Buses" ? "active" : "")" asp-controller="Admin" asp-action="Buses">
                    <i class="bi bi-bus-front"></i>Bus Fleet
                </a>
                <a class="nav-link @(currentAction == "Routes" ? "active" : "")" asp-controller="Admin" asp-action="Routes">
                    <i class="bi bi-signpost-split"></i>Routes
                </a>
                <a class="nav-link @(currentAction == "Schedules" ? "active" : "")" asp-controller="Admin" asp-action="Schedules">
                    <i class="bi bi-calendar-week"></i>Schedules & Seats
                </a>
                <a class="nav-link @(currentAction == "Fares" ? "active" : "")" asp-controller="Admin" asp-action="Fares">
                    <i class="bi bi-currency-rupee"></i>Official Fares
                </a>
                <a class="nav-link @(currentAction == "Bookings" ? "active" : "")" asp-controller="Admin" asp-action="Bookings">
                    <i class="bi bi-ticket-perforated"></i>Bookings & Refunds
                </a>
                <a class="nav-link @(currentAction == "Passes" ? "active" : "")" asp-controller="Admin" asp-action="Passes">
                    <i class="bi bi-person-badge"></i>Bus Pass Approvals
                </a>
                <a class="nav-link" asp-controller="Ticket" asp-action="Verify">
                    <i class="bi bi-qr-code-scan"></i>QR Ticket Scanner
                </a>
                <a class="nav-link @(currentAction == "AuditLogs" ? "active" : "")" asp-controller="Admin" asp-action="AuditLogs">
                    <i class="bi bi-journal-check"></i>Security Audit Logs
                </a>
            </nav>

            <div class="pt-3 border-top border-secondary">
                <a class="nav-link text-info" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left-circle"></i>Return to Portal</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="nav-link text-danger border-0 bg-transparent w-100 text-start">
                        <i class="bi bi-box-arrow-right"></i>Sign Out
                    </button>
                </form>
            </div>
        </aside>

        <div class="cp-admin-main d-flex flex-column">
            <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold text-dark">@ViewData["Title"]</h5>
                    <div class="small text-muted">Role-Protected Operations & Telemetry Console</div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <a href="/health" target="_blank" class="badge text-bg-success text-decoration-none px-3 py-2 rounded-pill">
                        <i class="bi bi-activity me-1"></i>Cloud Health: Online
                    </a>
                    <span class="small fw-semibold text-dark"><i class="bi bi-shield-fill-check text-primary me-1"></i>@User.Identity?.Name</span>
                </div>
            </header>

            <div class="p-4 flex-grow-1">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
