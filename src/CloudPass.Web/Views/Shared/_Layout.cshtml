<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CloudPass | Smart Cloud Bus Pass & Ticket Booking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/cloudpass.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark cp-navbar">
        <div class="container">
            <a class="cp-brand" asp-controller="Home" asp-action="Index">
                <svg width="34" height="34" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect width="36" height="36" rx="10" fill="url(#cpLogoGrad)"/>
                    <path d="M9 17.5C9 13.9 11.8 11 15.4 11H21.5C24.5 11 27 13.5 27 16.5V22.5H9V17.5Z" stroke="white" stroke-width="2" stroke-linejoin="round"/>
                    <circle cx="13.5" cy="24.5" r="2" fill="#22D3EE"/>
                    <circle cx="22.5" cy="24.5" r="2" fill="#22D3EE"/>
                    <path d="M12 16H24" stroke="#67E8F9" stroke-width="1.8" stroke-linecap="round"/>
                    <defs>
                        <linearGradient id="cpLogoGrad" x1="0" y1="0" x2="36" y2="36" gradientUnits="userSpaceOnUse">
                            <stop stop-color="#2563EB"/>
                            <stop offset="1" stop-color="#06B6D4"/>
                        </linearGradient>
                    </defs>
                </svg>
                <span>CLOUD<span class="cp-brand-accent">PASS</span></span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#cpNavMenu" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="cpNavMenu">
                <ul class="navbar-nav me-auto ms-lg-4 gap-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Bus" asp-action="Search"><i class="bi bi-search me-1"></i>Search Buses</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Pass" asp-action="Index"><i class="bi bi-person-badge me-1"></i>Bus Passes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Ticket" asp-action="Verify"><i class="bi bi-qr-code-scan me-1"></i>Verify QR</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="CloudArchitecture"><i class="bi bi-cloud-check me-1"></i>Cloud Architecture</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="nav-link" asp-controller="Booking" asp-action="MyBookings"><i class="bi bi-ticket-perforated me-1"></i>My Bookings</a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a class="btn btn-sm btn-info text-dark fw-bold rounded-pill px-3" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-shield-lock-fill me-1"></i>Admin Panel
                            </a>
                        }

                        <!-- Notification Bell -->
                        <div class="dropdown">
                            <button class="btn btn-link text-light position-relative p-2" type="button" data-bs-toggle="dropdown" aria-label="Notifications">
                                <i class="bi bi-bell fs-5"></i>
                                <span id="cpNotifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-info text-dark d-none" style="font-size:0.65rem;">0</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0" style="width:330px;border-radius:14px;overflow:hidden;">
                                <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-dark text-white">
                                    <span class="fw-bold small"><i class="bi bi-bell-fill text-info me-1"></i>Notifications</span>
                                    <button type="button" class="btn btn-link btn-sm text-info text-decoration-none p-0" onclick="cpMarkAllNotificationsRead()">Mark all read</button>
                                </div>
                                <div id="cpNotifList" style="max-height:300px;overflow-y:auto;">
                                    <div class="p-3 text-center text-muted small">Loading...</div>
                                </div>
                            </div>
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-light rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="border-radius:12px;">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                <li><a class="dropdown-item" asp-controller="Booking" asp-action="MyBookings"><i class="bi bi-ticket-detailed me-2"></i>My Bookings</a></li>
                                <li><a class="dropdown-item" asp-controller="Pass" asp-action="Index"><i class="bi bi-card-heading me-2"></i>My Bus Passes</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-light rounded-pill px-3" asp-controller="Account" asp-action="Login">Sign In</a>
                        <a class="btn btn-sm btn-cp-primary rounded-pill px-3" asp-controller="Account" asp-action="Register">Create Account</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Global Toast / Alert Area -->
    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="container mt-3 no-print">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-4 d-flex align-items-center" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                    <div>@TempData["Success"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-4 d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                    <div>@TempData["Error"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="cp-footer mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="cp-brand mb-2">
                        <span>CLOUD<span class="cp-brand-accent">PASS</span></span>
                    </div>
                    <p class="small mb-2 text-info fw-semibold">Your Journey. Your Ticket. Always Connected.</p>
                    <p class="small">Enterprise cloud-native bus ticket booking & commuter pass platform engineered for Microsoft Azure high availability, autoscaling, and cryptographic ticket verification.</p>
                    <div class="d-flex gap-2 mt-3">
                        <span class="badge bg-dark border border-secondary text-info"><i class="bi bi-shield-check me-1"></i>HMAC-SHA256 QR</span>
                        <span class="badge bg-dark border border-secondary text-light"><i class="bi bi-cloud-arrow-up me-1"></i>Azure Ready</span>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="text-white fw-bold mb-3">Platform</h6>
                    <ul class="list-unstyled small d-grid gap-2">
                        <li><a asp-controller="Bus" asp-action="Search">Search Buses</a></li>
                        <li><a asp-controller="Pass" asp-action="Index">Monthly Bus Passes</a></li>
                        <li><a asp-controller="Ticket" asp-action="Verify">Verify Digital Ticket</a></li>
                        <li><a asp-controller="Home" asp-action="CloudArchitecture">Cloud Architecture</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="text-white fw-bold mb-3">Cloud Reliability</h6>
                    <ul class="list-unstyled small d-grid gap-2">
                        <li><a href="/health" target="_blank"><i class="bi bi-heart-pulse text-success me-1"></i>System Health JSON</a></li>
                        <li><a href="/health/ready" target="_blank"><i class="bi bi-database-check text-info me-1"></i>Readiness Probe</a></li>
                        <li><a asp-controller="Account" asp-action="Profile">Account Security</a></li>
                        <li><a asp-controller="Booking" asp-action="MyBookings">Manage Bookings</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6 class="text-white fw-bold mb-3">24×7 Support</h6>
                    <ul class="list-unstyled small d-grid gap-2">
                        <li><i class="bi bi-envelope text-info me-2"></i>support@cloudpass.io</li>
                        <li><i class="bi bi-telephone text-info me-2"></i>+91 1800-202-PASS (Demo)</li>
                        <li><i class="bi bi-geo-alt text-info me-2"></i>Cloud Mobility Hub, BKC Mumbai</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="d-flex flex-wrap justify-content-between align-items-center small">
                <div>© @DateTime.UtcNow.Year CloudPass Mobility Systems. Built with ASP.NET Core MVC, EF Core & Microsoft Azure Architecture.</div>
                <div class="text-info">Zero-Trust Pricing • Concurrency-Safe Seats • Signed QR Tokens</div>
            </div>
        </div>
    </footer>

    <div id="cpLoadingOverlay">
        <div class="bg-white rounded-4 p-4 shadow-lg text-center">
            <div class="spinner-border text-primary mb-2" role="status"></div>
            <div class="fw-bold text-dark small">Securing your cloud transaction...</div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/cloudpass.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
