@model PaymentPageViewModel
@{
    ViewData["Title"] = "Secure Payment Verification";
    var b = Model.Booking;
    var p = Model.Payment;
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="cp-card overflow-hidden">
                <div class="p-4 text-white" style="background:linear-gradient(135deg,#061024,#132A54);">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <span class="badge bg-info text-dark fw-bold mb-1">RAZORPAY TEST-MODE GATEWAY</span>
                            <h4 class="fw-bold mb-0">Complete Payment to Issue Digital Ticket</h4>
                        </div>
                        <div class="text-end">
                            <div class="small text-info">Booking Reference</div>
                            <div class="fs-5 fw-bold">@b.BookingReference</div>
                        </div>
                    </div>
                </div>

                <div class="p-4 p-md-5">
                    <div class="alert alert-info rounded-4 border-0 small mb-4">
                        <i class="bi bi-shield-lock-fill me-2"></i>
                        <strong>PCI-Safe Sandbox Architecture:</strong> CloudPass NEVER collects or stores raw credit/debit card numbers. Payment confirmation requires server-side HMAC-SHA256 signature verification (or signed webhook at <code>POST /api/payments/webhook</code>) before confirming your seats and issuing the signed QR ticket.
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-4 h-100 small">
                                <div class="fw-bold text-dark mb-2">Reserved Journey Summary</div>
                                <div><strong>Route:</strong> @b.BusSchedule.Route.SourceCity → @b.BusSchedule.Route.DestinationCity</div>
                                <div><strong>Bus:</strong> @b.BusSchedule.Bus.BusName (@b.BusSchedule.Bus.BusNumber)</div>
                                <div><strong>Departure:</strong> @b.BusSchedule.DepartureTime.ToString("dd MMM yyyy, HH:mm")</div>
                                <div><strong>Seats:</strong> @string.Join(", ", b.Passengers.Select(x => x.SeatNumber))</div>
                                <div class="mt-2"><span class="badge text-bg-warning">Booking Status: PendingPayment</span></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-4 h-100 small">
                                <div class="fw-bold text-dark mb-2">Server-Verified Gateway Order</div>
                                <div><strong>Gateway:</strong> @p.GatewayName</div>
                                <div><strong>Order ID:</strong> <code>@p.GatewayOrderId</code></div>
                                <div><strong>Key ID:</strong> <code>@Model.GatewayKeyId</code></div>
                                <hr class="my-2" />
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold">Amount Payable</span>
                                    <span class="fs-4 fw-extrabold text-primary">INR @b.TotalAmount.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-3">Choose Sandbox Payment Method (Test Mode)</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <button type="button" class="btn btn-outline-primary w-100 p-3 rounded-4 text-start"
                                    onclick="cpExecuteTestPayment('@b.BookingReference','@p.GatewayOrderId','UPI Sandbox')">
                                <i class="bi bi-phone fs-4 d-block mb-1"></i>
                                <div class="fw-bold">UPI / QR (Test)</div>
                                <div class="small text-muted">Instant HMAC-verified</div>
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-outline-primary w-100 p-3 rounded-4 text-start"
                                    onclick="cpExecuteTestPayment('@b.BookingReference','@p.GatewayOrderId','NetBanking Sandbox')">
                                <i class="bi bi-bank fs-4 d-block mb-1"></i>
                                <div class="fw-bold">NetBanking (Test)</div>
                                <div class="small text-muted">Bank token simulation</div>
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-outline-primary w-100 p-3 rounded-4 text-start"
                                    onclick="cpExecuteTestPayment('@b.BookingReference','@p.GatewayOrderId','Tokenized Card Sandbox')">
                                <i class="bi bi-credit-card-2-front fs-4 d-block mb-1"></i>
                                <div class="fw-bold">Tokenized Card</div>
                                <div class="small text-muted">Zero card data stored</div>
                            </button>
                        </div>
                    </div>

                    <!-- Hidden server confirmation form submitted after signed sandbox authorization -->
                    <form id="cpConfirmPaymentForm" asp-action="ConfirmPayment" method="post">
                        <input type="hidden" name="bookingReference" value="@b.BookingReference" />
                        <input type="hidden" name="gatewayOrderId" value="@p.GatewayOrderId" />
                        <input type="hidden" id="cpGatewayPaymentId" name="gatewayPaymentId" />
                        <input type="hidden" id="cpGatewaySignature" name="gatewaySignature" />
                    </form>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="MyBookings" class="btn btn-link text-muted text-decoration-none small">Pay Later / View Pending Bookings</a>
                        <form asp-action="Cancel" method="post">
                            <input type="hidden" name="bookingReference" value="@b.BookingReference" />
                            <input type="hidden" name="reason" value="User abandoned checkout" />
                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-3">Cancel &amp; Release Seats</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
