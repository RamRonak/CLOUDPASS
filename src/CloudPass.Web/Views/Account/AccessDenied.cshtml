@{
    ViewData["Title"] = "Access Denied";
}
<section class="container py-5 text-center">
    <div class="cp-card p-5 mx-auto" style="max-width:540px;">
        <i class="bi bi-shield-slash-fill text-danger" style="font-size:3.2rem;"></i>
        <h3 class="fw-bold mt-3">Access Restricted</h3>
        <p class="text-muted">CloudPass role-based authorization & ownership controls prevented access to this resource. This security event has been logged.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-cp-primary mt-2">Return to Homepage</a>
    </div>
</section>
