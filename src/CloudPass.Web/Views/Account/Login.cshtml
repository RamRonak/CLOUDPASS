@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="cp-card p-4 p-md-5 cp-fade-in">
                <div class="text-center mb-4">
                    <div class="cp-icon-box mx-auto mb-3"><i class="bi bi-shield-lock-fill"></i></div>
                    <h3 class="fw-bold mb-1">Sign In to CloudPass</h3>
                    <p class="text-muted small">Access your digital tickets, commuter passes, and bookings.</p>
                </div>

                <form asp-action="Login" method="post" data-loading="true">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3 py-2"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <input asp-for="Email" class="form-control form-control-lg rounded-3" placeholder="you@cloudpass.io" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <label asp-for="Password" class="form-label fw-semibold small"></label>
                            <a asp-action="ForgotPassword" class="small text-decoration-none">Forgot password?</a>
                        </div>
                        <input asp-for="Password" class="form-control form-control-lg rounded-3" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted">Keep me signed in on this device</label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-cp-primary btn-lg">Sign In Securely</button>
                    </div>
                </form>

                <div class="text-center small text-muted mb-4">
                    New to CloudPass? <a asp-action="Register" class="fw-semibold text-decoration-none">Create an account</a>
                </div>

                <!-- Demo Credentials Helper for College Presentation -->
                <div class="bg-light border rounded-3 p-3 small">
                    <div class="fw-bold text-dark mb-2"><i class="bi bi-mortarboard text-primary me-1"></i>Demo Accounts (Seeded Local Data)</div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span><strong>Passenger:</strong> <code>passenger@cloudpass.io</code> / <code>Pass@123!</code></span>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="fillDemo('passenger@cloudpass.io','Pass@123!')">Fill</button>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span><strong>Admin:</strong> <code>admin@cloudpass.io</code> / <code>Admin@123!</code></span>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="fillDemo('admin@cloudpass.io','Admin@123!')">Fill</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
function fillDemo(email, pass) {
    document.getElementById('Email').value = email;
    document.getElementById('Password').value = pass;
}
</script>
}
