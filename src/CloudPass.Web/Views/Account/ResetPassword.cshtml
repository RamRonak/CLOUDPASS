@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Set New Password";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="cp-card p-4 p-md-5">
                <h4 class="fw-bold mb-3"><i class="bi bi-shield-check text-primary me-2"></i>Set a New Password</h4>
                <form asp-action="ResetPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3 py-2"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold"></label>
                        <input asp-for="Email" class="form-control rounded-3" readonly />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Token" class="form-label small fw-semibold"></label>
                        <input asp-for="Token" class="form-control rounded-3" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label small fw-semibold"></label>
                        <input asp-for="NewPassword" class="form-control rounded-3" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control rounded-3" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-cp-primary">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
