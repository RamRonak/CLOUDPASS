@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="cp-card p-4 p-md-5">
                <h4 class="fw-bold mb-2"><i class="bi bi-key text-primary me-2"></i>Reset Your Password</h4>
                <p class="small text-muted mb-4">Enter your registered email to generate a secure 30-minute reset token.</p>

                @if (ViewBag.Submitted == true)
                {
                    <div class="alert alert-info rounded-3 small">
                        If an active account matches that email, a time-limited reset token has been generated.
                    </div>
                    @if (ViewBag.DemoResetUrl != null)
                    {
                        <div class="alert alert-success rounded-3 small">
                            <strong>Sandbox Demo Reset Link (No SMTP Required):</strong><br />
                            <a href="@ViewBag.DemoResetUrl" class="fw-bold">Click here to set a new password</a>
                        </div>
                    }
                }

                <form asp-action="ForgotPassword" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <input asp-for="Email" class="form-control rounded-3" placeholder="passenger@cloudpass.io" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-cp-primary">Generate Reset Token</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
