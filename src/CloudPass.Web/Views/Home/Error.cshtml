@{
    ViewData["Title"] = "Service Notice";
}
<div class="container py-5 text-center">
    <div class="cp-card p-5 mx-auto" style="max-width:560px;">
        <i class="bi bi-shield-exclamation text-danger" style="font-size:3rem;"></i>
        <h3 class="fw-bold mt-3">Something went wrong</h3>
        <p class="text-muted">CloudPass handled an unexpected error gracefully so your session remains protected. Please retry or return to the homepage.</p>
        @if (ViewBag.RequestId != null)
        {
            <div class="small text-muted mb-3">Trace ID: <code>@ViewBag.RequestId</code></div>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-cp-primary">Return Home</a>
    </div>
</div>
