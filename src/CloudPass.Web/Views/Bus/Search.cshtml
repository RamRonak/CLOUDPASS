@model BusSearchViewModel
@{
    ViewData["Title"] = "Search Available Buses";
    var f = Model.Filter;
}

<section class="bg-dark text-white py-4" style="background:linear-gradient(135deg,#061024,#132A54) !important;">
    <div class="container">
        <form asp-action="Search" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-info mb-1">From</label>
                <input type="text" id="srchSource" name="Source" list="searchCities" value="@f.Source" class="form-control rounded-3" placeholder="Any source city" />
            </div>
            <div class="col-auto d-none d-md-block">
                <button type="button" class="btn btn-outline-info btn-sm rounded-circle" onclick="cpSwapCities('srchSource','srchDest')"><i class="bi bi-arrow-left-right"></i></button>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-info mb-1">To</label>
                <input type="text" id="srchDest" name="Destination" list="searchCities" value="@f.Destination" class="form-control rounded-3" placeholder="Any destination" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-info mb-1">Journey Date</label>
                <input type="date" name="JourneyDate" value="@f.JourneyDate?.ToString("yyyy-MM-dd")" class="form-control rounded-3" />
            </div>
            <div class="col-md-1">
                <label class="form-label small text-info mb-1">Seats</label>
                <select name="Passengers" class="form-select rounded-3">
                    @for (int i = 1; i <= 6; i++)
                    {
                        <option value="@i" selected="@(f.Passengers == i)">@i</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-cp-primary"><i class="bi bi-search me-1"></i>Search</button>
            </div>
        </form>
        <datalist id="searchCities">
            @foreach (var c in Model.AvailableCities)
            {
                <option value="@c"></option>
            }
        </datalist>
    </div>
</section>

<section class="container py-4">
    <div class="row g-4">
        <!-- FILTERS SIDEBAR -->
        <div class="col-lg-3">
            <div class="cp-card p-4 sticky-top" style="top:88px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-funnel text-primary me-1"></i>Smart Filters</h6>
                    <a asp-action="Search" asp-route-Source="@f.Source" asp-route-Destination="@f.Destination" asp-route-JourneyDate="@f.JourneyDate?.ToString("yyyy-MM-dd")" class="small text-decoration-none">Reset</a>
                </div>

                <form asp-action="Search" method="get">
                    <input type="hidden" name="Source" value="@f.Source" />
                    <input type="hidden" name="Destination" value="@f.Destination" />
                    <input type="hidden" name="JourneyDate" value="@f.JourneyDate?.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="Passengers" value="@f.Passengers" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Climate Control</label>
                        <select name="HasAC" class="form-select form-select-sm rounded-3">
                            <option value="">All (AC &amp; Non-AC)</option>
                            <option value="true" selected="@(f.HasAC == true)">AC Only</option>
                            <option value="false" selected="@(f.HasAC == false)">Non-AC Only</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Coach Configuration</label>
                        <select name="IsSleeper" class="form-select form-select-sm rounded-3">
                            <option value="">All (Sleeper &amp; Seater)</option>
                            <option value="true" selected="@(f.IsSleeper == true)">Sleeper Berths</option>
                            <option value="false" selected="@(f.IsSleeper == false)">Seater Recliner</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Departure Window</label>
                        <select name="DepartureWindow" class="form-select form-select-sm rounded-3">
                            <option value="">Any Time</option>
                            <option value="Morning" selected="@(f.DepartureWindow == "Morning")">Morning (05:00 – 12:00)</option>
                            <option value="Afternoon" selected="@(f.DepartureWindow == "Afternoon")">Afternoon (12:00 – 17:00)</option>
                            <option value="Evening" selected="@(f.DepartureWindow == "Evening")">Evening (17:00 – 21:00)</option>
                            <option value="Night" selected="@(f.DepartureWindow == "Night")">Night (21:00 – 05:00)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Price Range (INR)</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" name="MinPrice" value="@f.MinPrice" class="form-control form-control-sm rounded-3" placeholder="Min" min="0" />
                            </div>
                            <div class="col-6">
                                <input type="number" name="MaxPrice" value="@f.MaxPrice" class="form-control form-control-sm rounded-3" placeholder="Max" min="0" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Sort Results</label>
                        <select name="SortBy" class="form-select form-select-sm rounded-3">
                            <option value="departure_asc" selected="@(f.SortBy == "departure_asc" || string.IsNullOrEmpty(f.SortBy))">Earliest Departure</option>
                            <option value="price_asc" selected="@(f.SortBy == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(f.SortBy == "price_desc")">Price: High to Low</option>
                            <option value="seats_desc" selected="@(f.SortBy == "seats_desc")">Most Seats Available</option>
                        </select>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-cp-navy btn-sm">Apply Filters</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RESULTS LIST -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h4 class="fw-bold mb-0">
                        @(string.IsNullOrWhiteSpace(f.Source) ? "All Corridors" : f.Source)
                        @if (!string.IsNullOrWhiteSpace(f.Destination))
                        {
                            <i class="bi bi-arrow-right text-info mx-1"></i>@f.Destination
                        }
                    </h4>
                    <div class="small text-muted">Showing <strong>@Model.Results.Count</strong> live database schedule(s) • Official fares guaranteed server-side</div>
                </div>
            </div>

            @if (!Model.Results.Any())
            {
                <div class="cp-card p-5 text-center">
                    <i class="bi bi-bus-front text-muted" style="font-size:3rem;"></i>
                    <h5 class="fw-bold mt-3">No matching buses found</h5>
                    <p class="small text-muted">Try clearing filters or selecting another journey date (schedules are seeded for the next 5 days).</p>
                    <a asp-action="Search" class="btn btn-cp-primary btn-sm">Show All Available Buses</a>
                </div>
            }
            else
            {
                <div class="d-grid gap-3">
                    @foreach (var s in Model.Results)
                    {
                        var dur = s.ArrivalTime - s.DepartureTime;
                        <div class="cp-card cp-card-hover p-4">
                            <div class="row align-items-center g-3">
                                <div class="col-lg-4">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="cp-pill @(s.Bus.HasAC ? "cp-pill-cyan" : "cp-pill-amber")">@s.Bus.BusType</span>
                                        <span class="small text-muted">@s.Bus.BusNumber</span>
                                    </div>
                                    <h5 class="fw-bold mb-1 text-dark">@s.Bus.BusName</h5>
                                    <div class="small text-muted"><i class="bi bi-building me-1"></i>@s.Bus.OperatorName</div>
                                    <div class="small text-muted mt-1"><i class="bi bi-calendar3 me-1"></i>@s.JourneyDate.ToString("ddd, dd MMM yyyy")</div>
                                </div>

                                <div class="col-lg-5">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <div class="fs-5 fw-bold text-dark">@s.DepartureTime.ToString("HH:mm")</div>
                                            <div class="small fw-semibold">@s.Route.SourceCity</div>
                                            <div class="text-muted" style="font-size:0.75rem;">@s.BoardingPoint</div>
                                        </div>
                                        <div class="text-center px-2">
                                            <div class="small text-muted">@((int)dur.TotalHours)h @(dur.Minutes)m</div>
                                            <div class="text-info fw-bold">─── <i class="bi bi-bus-front-fill"></i> ───</div>
                                            <div style="font-size:0.72rem;" class="text-muted">@s.Route.DistanceKm km</div>
                                        </div>
                                        <div class="text-end">
                                            <div class="fs-5 fw-bold text-dark">@s.ArrivalTime.ToString("HH:mm")</div>
                                            <div class="small fw-semibold">@s.Route.DestinationCity</div>
                                            <div class="text-muted" style="font-size:0.75rem;">@s.DroppingPoint</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 text-lg-end border-start-lg">
                                    <div class="small text-muted">Official Seat Fare</div>
                                    <div class="fs-4 fw-extrabold text-primary mb-1">INR @s.OfficialFare.ToString("N0")</div>
                                    <div class="small mb-2 @(s.AvailableSeats <= 5 ? "text-danger fw-bold" : "text-success fw-semibold")">
                                        <i class="bi bi-grid-3x3-gap me-1"></i>@s.AvailableSeats seats available
                                    </div>
                                    <a asp-action="Details" asp-route-id="@s.Id" asp-route-passengers="@f.Passengers" class="btn btn-cp-primary btn-sm w-100">
                                        Select Seats <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>
