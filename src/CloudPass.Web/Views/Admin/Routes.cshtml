@model List<CloudPass.Domain.Entities.Route>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Route Management";
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="cp-card p-4">
            <h6 class="fw-bold mb-3" id="routeFormTitle"><i class="bi bi-signpost-split text-primary me-2"></i>Add / Edit Route</h6>
            <form asp-action="SaveRoute" method="post">
                <input type="hidden" id="routeId" name="id" value="0" />
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Source City *</label>
                        <input id="sourceCity" name="sourceCity" class="form-control form-control-sm rounded-3" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Destination City *</label>
                        <input id="destinationCity" name="destinationCity" class="form-control form-control-sm rounded-3" required />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Distance (km)</label>
                        <input type="number" step="0.1" id="distanceKm" name="distanceKm" value="200" class="form-control form-control-sm rounded-3" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Duration (mins)</label>
                        <input type="number" id="estimatedDurationMinutes" name="estimatedDurationMinutes" value="240" class="form-control form-control-sm rounded-3" required />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Base Fare (INR)</label>
                        <input type="number" step="0.01" id="baseFare" name="baseFare" value="500" class="form-control form-control-sm rounded-3" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Service Fee (INR)</label>
                        <input type="number" step="0.01" id="serviceFee" name="serviceFee" value="35" class="form-control form-control-sm rounded-3" required />
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">GST / Tax (%)</label>
                        <input type="number" step="0.01" id="taxPercentage" name="taxPercentage" value="5" class="form-control form-control-sm rounded-3" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Monthly Pass (INR)</label>
                        <input type="number" step="0.01" id="monthlyPassBasePrice" name="monthlyPassBasePrice" value="2400" class="form-control form-control-sm rounded-3" required />
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-cp-primary btn-sm flex-grow-1">Save Route</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('routeId').value=0;document.getElementById('routeFormTitle').textContent='Add New Route';">Reset</button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="cp-card p-4">
            <h6 class="fw-bold mb-3">Active Transit Corridors (@Model.Count)</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr><th>Corridor</th><th>Distance</th><th>Duration</th><th>Base Fare</th><th>Monthly Pass</th><th class="text-end">Action</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="fw-bold">@r.SourceCity → @r.DestinationCity</td>
                                <td>@r.DistanceKm km</td>
                                <td>@(r.EstimatedDurationMinutes / 60)h @(r.EstimatedDurationMinutes % 60)m</td>
                                <td>INR @r.BaseFare.ToString("N0") (+@r.ServiceFee fee, @r.TaxPercentage% tax)</td>
                                <td>INR @r.MonthlyPassBasePrice.ToString("N0")</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-primary btn-sm"
                                            onclick='editRoute(@r.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.SourceCity)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.DestinationCity)), @r.DistanceKm.ToString(System.Globalization.CultureInfo.InvariantCulture), @r.EstimatedDurationMinutes, @r.BaseFare.ToString(System.Globalization.CultureInfo.InvariantCulture), @r.ServiceFee.ToString(System.Globalization.CultureInfo.InvariantCulture), @r.TaxPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture), @r.MonthlyPassBasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture))'>Edit</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function editRoute(id, src, dst, dist, dur, fare, fee, tax, pass) {
    document.getElementById('routeFormTitle').textContent = 'Edit Route #' + id;
    document.getElementById('routeId').value = id;
    document.getElementById('sourceCity').value = src;
    document.getElementById('destinationCity').value = dst;
    document.getElementById('distanceKm').value = dist;
    document.getElementById('estimatedDurationMinutes').value = dur;
    document.getElementById('baseFare').value = fare;
    document.getElementById('serviceFee').value = fee;
    document.getElementById('taxPercentage').value = tax;
    document.getElementById('monthlyPassBasePrice').value = pass;
}
</script>
}
