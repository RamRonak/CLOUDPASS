@model List<Bus>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bus Fleet Management";
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="cp-card p-4">
            <h6 class="fw-bold mb-3" id="busFormTitle"><i class="bi bi-plus-circle text-primary me-2"></i>Add New Bus to Fleet</h6>
            <form asp-action="SaveBus" method="post">
                <input type="hidden" id="busId" name="id" value="0" />
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Bus Name *</label>
                    <input id="busName" name="busName" class="form-control form-control-sm rounded-3" placeholder="CloudLiner Volvo 9600" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Registration Number *</label>
                    <input id="busNumber" name="busNumber" class="form-control form-control-sm rounded-3" placeholder="MH-12-CP-1024" required />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Operator Name *</label>
                    <input id="operatorName" name="operatorName" class="form-control form-control-sm rounded-3" placeholder="CloudPass Premier" required />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" id="hasAC" name="hasAC" value="true" checked />
                            <label class="form-check-label small" for="hasAC">Air Conditioned</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" id="isSleeper" name="isSleeper" value="true" checked />
                            <label class="form-check-label small" for="isSleeper">Sleeper Berths</label>
                        </div>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Seating Capacity (16–56)</label>
                    <input type="number" id="totalSeats" name="totalSeats" value="30" min="16" max="56" class="form-control form-control-sm rounded-3" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Amenities</label>
                    <input id="amenities" name="amenities" class="form-control form-control-sm rounded-3" value="WiFi, USB Charging, Live GPS, CCTV" />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-cp-primary btn-sm flex-grow-1">Save Bus</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetBusForm()">Reset</button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="cp-card p-4">
            <h6 class="fw-bold mb-3">Registered Fleet (@Model.Count)</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr><th>Bus &amp; Operator</th><th>Reg. Number</th><th>Type</th><th>Seats</th><th>Status</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td><strong>@b.BusName</strong><div class="text-muted" style="font-size:0.75rem;">@b.OperatorName</div></td>
                                <td class="font-monospace">@b.BusNumber</td>
                                <td><span class="cp-pill @(b.HasAC ? "cp-pill-cyan" : "cp-pill-amber")">@b.BusType</span></td>
                                <td>@b.TotalSeats</td>
                                <td><span class="badge @(b.IsActive ? "text-bg-success" : "text-bg-secondary")">@(b.IsActive ? "Active" : "Inactive")</span></td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-primary btn-sm me-1"
                                            onclick='editBus(@b.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(b.BusName)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(b.BusNumber)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(b.OperatorName)), @(b.HasAC ? "true" : "false"), @(b.IsSleeper ? "true" : "false"), @b.TotalSeats, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(b.Amenities)))'>Edit</button>
                                    <form asp-action="DeleteBus" method="post" class="d-inline" onsubmit="return confirm('Toggle/Delete bus @b.BusNumber?');">
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">@(b.IsActive ? "Deactivate" : "Activate")</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function editBus(id, name, num, op, ac, sleeper, seats, amenities) {
    document.getElementById('busFormTitle').textContent = 'Edit Bus #' + id;
    document.getElementById('busId').value = id;
    document.getElementById('busName').value = name;
    document.getElementById('busNumber').value = num;
    document.getElementById('operatorName').value = op;
    document.getElementById('hasAC').checked = ac;
    document.getElementById('isSleeper').checked = sleeper;
    document.getElementById('totalSeats').value = seats;
    document.getElementById('amenities').value = amenities;
}
function resetBusForm() {
    document.getElementById('busFormTitle').textContent = 'Add New Bus to Fleet';
    document.getElementById('busId').value = 0;
    document.getElementById('busName').value = '';
    document.getElementById('busNumber').value = '';
    document.getElementById('operatorName').value = '';
    document.getElementById('totalSeats').value = 30;
}
</script>
}
