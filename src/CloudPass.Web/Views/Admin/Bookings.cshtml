@model List<Booking>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Booking & Payment Management";
}

<div class="cp-card p-4 mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small fw-semibold">Search Bookings</label>
            <input name="search" value="@ViewBag.Search" class="form-control form-control-sm rounded-3" placeholder="Booking reference, passenger name, email, or city..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Booking Status</label>
            <select name="status" class="form-select form-select-sm rounded-3">
                <option value="">All Statuses</option>
                @foreach (BookingStatus st in Enum.GetValues(typeof(BookingStatus)))
                {
                    <option value="@st" selected="@(ViewBag.Status?.ToString() == st.ToString())">@st</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-cp-primary btn-sm">Filter</button>
            <a asp-action="Bookings" class="btn btn-outline-secondary btn-sm">Reset</a>
            <a asp-controller="Ticket" asp-action="Verify" class="btn btn-cp-navy btn-sm ms-auto"><i class="bi bi-qr-code-scan me-1"></i>Verify QR</a>
        </div>
    </form>
</div>

<div class="cp-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr><th>Ref</th><th>Passenger</th><th>Route &amp; Date</th><th>Seats</th><th>Amount</th><th>Status / Payment</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="font-monospace fw-bold">@b.BookingReference</td>
                        <td><strong>@b.User.FullName</strong><div class="text-muted" style="font-size:0.74rem;">@b.User.Email</div></td>
                        <td>@b.BusSchedule.Route.SourceCity → @b.BusSchedule.Route.DestinationCity<div class="text-muted" style="font-size:0.74rem;">@b.BusSchedule.DepartureTime.ToString("dd MMM yyyy, HH:mm")</div></td>
                        <td>@string.Join(", ", b.Passengers.Select(p => p.SeatNumber))</td>
                        <td class="fw-bold">INR @b.TotalAmount.ToString("N2")</td>
                        <td>
                            <span class="badge @(b.BookingStatus == BookingStatus.Confirmed ? "text-bg-success" : b.BookingStatus == BookingStatus.Cancelled ? "text-bg-danger" : "text-bg-warning")">@b.BookingStatus</span>
                            <span class="badge @(b.PaymentStatus == PaymentStatus.Paid ? "text-bg-primary" : "text-bg-secondary")">@b.PaymentStatus</span>
                            @if (b.IsUsed) { <span class="badge text-bg-info text-dark">Boarded</span> }
                        </td>
                        <td class="text-end">
                            @if (b.BookingStatus == BookingStatus.Confirmed && b.PaymentStatus == PaymentStatus.Paid)
                            {
                                <a asp-controller="Ticket" asp-action="ViewTicket" asp-route-bookingRef="@b.BookingReference" class="btn btn-outline-primary btn-sm me-1">Ticket</a>
                            }
                            @if (b.BookingStatus != BookingStatus.Cancelled && !b.IsUsed)
                            {
                                <form asp-action="CancelBooking" method="post" class="d-inline" onsubmit="return confirm('Admin cancel booking @b.BookingReference?');">
                                    <input type="hidden" name="bookingReference" value="@b.BookingReference" />
                                    <input type="hidden" name="reason" value="Cancelled via Admin Console" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
