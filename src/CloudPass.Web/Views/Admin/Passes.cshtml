@model List<BusPassApplication>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bus Pass Applications & Issued Passes";
    var passes = ViewBag.Passes as List<BusPass> ?? new();
}

<div class="cp-card p-4 mb-4">
    <h6 class="fw-bold mb-3"><i class="bi bi-hourglass-split text-warning me-2"></i>Pass Applications Queue (@Model.Count)</h6>
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr><th>Ref</th><th>Commuter</th><th>Corridor &amp; Validity</th><th>ID Proof</th><th>Server Price</th><th>Status</th><th class="text-end">Decision</th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="font-monospace fw-bold">@a.ApplicationReference</td>
                        <td><strong>@a.User.FullName</strong><div class="text-muted" style="font-size:0.74rem;">@a.User.Email</div></td>
                        <td>@a.Route.SourceCity ↔ @a.Route.DestinationCity<div class="text-muted" style="font-size:0.74rem;">@a.DurationMonths mo from @a.RequestedStartDate.ToString("dd MMM yyyy")</div></td>
                        <td>@a.IdProofType<div class="text-muted" style="font-size:0.74rem;">@a.IdProofNumber</div></td>
                        <td class="fw-bold text-primary">INR @a.CalculatedPrice.ToString("N2")</td>
                        <td><span class="badge @(a.Status == PassApplicationStatus.Approved ? "text-bg-success" : a.Status == PassApplicationStatus.Rejected ? "text-bg-danger" : "text-bg-warning")">@a.Status</span></td>
                        <td class="text-end">
                            @if (a.Status == PassApplicationStatus.Pending)
                            {
                                <form asp-action="ApprovePass" method="post" class="d-inline me-1">
                                    <input type="hidden" name="applicationId" value="@a.Id" />
                                    <input type="hidden" name="remarks" value="Verified commuter credentials. Approved." />
                                    <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                </form>
                                <form asp-action="RejectPass" method="post" class="d-inline">
                                    <input type="hidden" name="applicationId" value="@a.Id" />
                                    <input type="hidden" name="remarks" value="Unable to verify commuter ID proof." />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">@a.AdminRemarks</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="cp-card p-4">
    <h6 class="fw-bold mb-3"><i class="bi bi-person-badge-fill text-primary me-2"></i>Issued Digital Bus Passes (@passes.Count)</h6>
    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr><th>Pass Number</th><th>Holder</th><th>Corridor</th><th>Validity</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var p in passes)
                {
                    <tr>
                        <td class="font-monospace fw-bold">@p.PassNumber</td>
                        <td>@p.User.FullName</td>
                        <td>@p.Route.SourceCity ↔ @p.Route.DestinationCity</td>
                        <td>@p.ValidFrom.ToString("dd MMM yyyy") – @p.ValidUntil.ToString("dd MMM yyyy")</td>
                        <td><span class="badge @(p.Status == BusPassStatus.Active ? "text-bg-success" : p.Status == BusPassStatus.Revoked ? "text-bg-danger" : "text-bg-secondary")">@p.Status</span></td>
                        <td class="text-end">
                            <a asp-controller="Pass" asp-action="ViewPass" asp-route-passNumber="@p.PassNumber" class="btn btn-outline-primary btn-sm me-1">View QR</a>
                            @if (p.Status == BusPassStatus.Active)
                            {
                                <form asp-action="RevokePass" method="post" class="d-inline" onsubmit="return confirm('Revoke bus pass @p.PassNumber?');">
                                    <input type="hidden" name="passId" value="@p.Id" />
                                    <input type="hidden" name="reason" value="Revoked by Admin" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Revoke</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
